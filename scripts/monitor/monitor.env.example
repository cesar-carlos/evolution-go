# Copy to /etc/evolution-go-monitor.env (mode 600) and schedule scripts/monitor/watch.py.
# The watcher runs on the host, outside the container, so it can still report when
# the API process is down. Leave MONITOR_SMTP_HOST empty to keep it silent.

# Destination. Several addresses can be separated by commas.
MONITOR_EMAIL_TO=operator@example.com
# Defaults to MONITOR_EMAIL_TO. Use the mailbox allowed by the SMTP account.
# MONITOR_EMAIL_FROM=operator@example.com

MONITOR_SMTP_HOST=
MONITOR_SMTP_PORT=587
MONITOR_SMTP_USER=
MONITOR_SMTP_PASSWORD=
# starttls, ssl, or none
MONITOR_SMTP_TLS=starttls

MONITOR_HTTP_URL=http://127.0.0.1:8081/server/ok
MONITOR_POSTGRES_CONTAINER=evolution-go-postgres
MONITOR_POSTGRES_USER=evogo
MONITOR_POSTGRES_DB=evogo_users
MONITOR_STATE_FILE=/var/lib/evolution-go-monitor/state.json

# API silence is reported after 2 minutes. Session loss waits 10 minutes so a
# restart can reconnect. A continuing outage is repeated after 6 hours.
MONITOR_API_DOWN_SECONDS=120
MONITOR_SESSION_DOWN_SECONDS=600
MONITOR_REPEAT_SECONDS=21600
# Alert when connected sessions fall to this fraction of the last stable count, or less.
MONITOR_DROP_RATIO=0.5
MONITOR_RECOVERY_STREAK=2
